{
  "openapi": "3.0.3",
  "info": {
    "title": "Portal Symfonia - Data Provider API",
    "description": "Multi-tenant ACL data provider dla OPA z integracją bazy danych PostgreSQL. Obsługuje Enhanced Model 1 (RBAC), zarządzanie użytkownikami, firmami, profilami aplikacji, zespołami oraz integrację z OPAL External Data Sources. **ZAKTUALIZOWANO w v3.2.0**: Dodano kompletne endpointy dla zespołów.",
    "version": "3.2.0",
    "contact": {
      "name": "Portal Symfonia Team",
      "email": "dev@portalsymfonia.pl"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8110",
      "description": "Development server (lokalny)"
    },
    {
      "url": "http://data-provider-api:8110",
      "description": "Docker container (wewnętrzny)"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Informacje o API",
        "description": "Zwraca podstawowe informacje o serwisie Data Provider API",
        "tags": ["System"],
        "responses": {
          "200": {"description": "Informacje o serwisie"}
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Sprawdza stan zdrowia serwisu i dostępność bazy danych",
        "tags": ["System"],
        "responses": {
          "200": {"description": "Serwis działa poprawnie"}
        }
      }
    },
    "/docs": {
      "get": {
        "summary": "Swagger UI",
        "description": "Interfejs dokumentacji API",
        "tags": ["System"],
        "responses": {
          "200": {"description": "Strona dokumentacji HTML"}
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "Specyfikacja OpenAPI",
        "description": "Zwraca pełną specyfikację OpenAPI w formacie JSON",
        "tags": ["System"],
        "responses": {
          "200": {"description": "Specyfikacja OpenAPI"},
          "404": {"description": "Plik specyfikacji nie został znaleziony"}
        }
      }
    },
    "/tenants": {
      "get": {
        "summary": "Lista wszystkich tenantów",
        "description": "Zwraca listę wszystkich dostępnych tenantów w systemie",
        "tags": ["Tenants"],
        "responses": {
          "200": {"description": "Lista tenantów"},
          "503": {"description": "Baza danych niedostępna"}
        }
      }
    },
    "/tenants/{tenant_id}/acl": {
      "get": {
        "summary": "Dane ACL dla tenanta",
        "description": "Zwraca dane ACL (Enhanced Model 1) dla określonego tenanta",
        "tags": ["ACL", "Tenants"],
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string"},
            "description": "Identyfikator tenanta"
          }
        ],
        "responses": {
          "200": {"description": "Dane ACL tenanta"},
          "404": {"description": "Tenant nie został znaleziony"},
          "503": {"description": "Baza danych niedostępna"}
        }
      }
    },
    "/api/users": {
      "get": {
        "summary": "Lista użytkowników",
        "description": "Zwraca listę użytkowników z opcjonalnym filtrowaniem",
        "tags": ["Users"],
        "parameters": [
          {"name": "tenant_id", "in": "query", "schema": {"type": "string"}},
          {"name": "status", "in": "query", "schema": {"type": "string", "default": "active"}}
        ],
        "responses": {
          "200": {"description": "Lista użytkowników"}
        }
      },
      "post": {
        "summary": "Utworz nowego użytkownika",
        "description": "Tworzy nowego użytkownika w systemie",
        "tags": ["Users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tenant_id", "username", "email"],
                "properties": {
                  "tenant_id": {"type": "string"},
                  "username": {"type": "string"},
                  "email": {"type": "string", "format": "email"},
                  "first_name": {"type": "string"},
                  "last_name": {"type": "string"},
                  "status": {"type": "string", "default": "active"}
                }
              }
            }
          }
        },
        "responses": {
          "201": {"description": "Użytkownik utworzony pomyślnie"}
        }
      }
    },
    "/api/users/{user_id}": {
      "get": {
        "summary": "Szczegóły użytkownika",
        "tags": ["Users"],
        "parameters": [{"name": "user_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Szczegóły użytkownika"}, "404": {"description": "Użytkownik nie znaleziony"}}
      },
      "delete": {
        "summary": "Usuń użytkownika",
        "tags": ["Users"],
        "parameters": [{"name": "user_id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Użytkownik usunięty pomyślnie"}}
      }
    },
