# OPA Zero Poll - Environment Configuration Template
# =================================================
# Skopiuj ten plik jako .env i dostosuj wartości do swoich potrzeb

# Database Configuration (PostgreSQL)
# ===================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=opa_user
DB_PASSWORD=opa_password
DB_NAME=opa_zero_poll

# API Configuration
# =================
DATA_PROVIDER_API_PORT=8110
PROVISIONING_API_PORT=8010
OPA_PORT=8181
OPAL_SERVER_PORT=7002
OPAL_CLIENT_PORT=7000

# Next.js Portal Configuration
# ============================
NEXT_PUBLIC_API_URL=http://localhost:8110
NEXT_PUBLIC_PROVISIONING_URL=http://localhost:8010
NEXT_PUBLIC_OPA_URL=http://localhost:8181

# OPAL Configuration
# ==================
OPAL_BROADCAST_URI=redis://localhost:6380
OPAL_POLICY_REPO_URL=https://github.com/plduser/opa-zero-poll.git
OPAL_POLICY_REPO_MAIN_BRANCH=main
OPAL_POLICY_REPO_PATH=new-architecture/components/opa-standalone/policies

# Security Configuration
# ======================
WEBHOOK_SECRET=twoj_super_tajny_klucz123!@#
DISABLE_JWT_VALIDATION=true

# Development Configuration
# =========================
DEBUG=false
LOG_LEVEL=info
NODE_ENV=development

# Docker Configuration
# ====================
# Automatycznie wykrywane przez setup.sh, ale można ustawić ręcznie:
# DOCKER_PLATFORM=linux/arm64  # dla macOS Apple Silicon
# DOCKER_PLATFORM=linux/amd64  # dla macOS Intel, Linux, Windows

# Portal UI Environment Variables
# ===============================
# Te zmienne są używane przez Next.js Portal

# API Endpoints (dostępne w browser)
NEXT_PUBLIC_DATA_PROVIDER_URL=http://localhost:8110
NEXT_PUBLIC_PROVISIONING_URL=http://localhost:8010
NEXT_PUBLIC_OPA_URL=http://localhost:8181

# Tenant Configuration
NEXT_PUBLIC_DEFAULT_TENANT=demo_tenant
NEXT_PUBLIC_MULTI_TENANT_MODE=true

# UI Configuration
NEXT_PUBLIC_APP_NAME="OPA Zero Poll"
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_COMPANY_NAME="Demo Company"

# Feature Flags
# =============
FEATURE_MULTI_TENANT=true
FEATURE_ADVANCED_RBAC=true
FEATURE_AUDIT_LOGS=true

#################################
# INSTRUKCJE KONFIGURACJI
#################################

# 1. PODSTAWOWA KONFIGURACJA:
#    - Skopiuj ten plik jako .env: cp env.template .env
#    - Dostosuj DB_PASSWORD do własnych potrzeb
#    - Zmień WEBHOOK_SECRET na unikalny klucz

# 2. DOCKER PLATFORM:
#    - Automatycznie wykrywane przez scripts/setup.sh
#    - Ręczna konfiguracja tylko jeśli automatyka nie działa

# 3. PORTAL UI:
#    - Wszystkie NEXT_PUBLIC_* zmienne są dostępne w przeglądarce
#    - Dostosuj URL-e jeśli używasz innych portów

# 4. PRODUKCJA:
#    - Ustaw DEBUG=false
#    - Zmień wszystkie domyślne hasła i klucze
#    - Wyłącz DISABLE_JWT_VALIDATION
#    - Ustaw NODE_ENV=production 